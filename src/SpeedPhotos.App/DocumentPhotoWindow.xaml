<Window x:Class="SpeedPhotos.App.DocumentPhotoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Foto para hoja de vida / carnet" Height="720" Width="1050" MinHeight="620" MinWidth="900" WindowStartupLocation="CenterOwner" Background="#EEF1F6">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#172033" Padding="18,12"><StackPanel><TextBlock Text="FOTO PARA DOCUMENTO" Foreground="White" FontSize="21" FontWeight="Bold"/><TextBlock Text="Importa una fotografía y genera copias de 3 × 4 cm listas para imprimir." Foreground="#CBD5E1" Margin="0,4,0,0"/></StackPanel></Border>
    <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,14,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <TextBlock Text="1. FOTOGRAFÍA" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,12"/>
        <Button Content="＋ Importar fotografía" Padding="12,9" Background="#2563EB" Foreground="White" BorderThickness="0" Click="ImportPhoto_Click"/>
        <Border Background="#E9EEF5" Height="250" Margin="0,14,0,8" Padding="8">
          <Viewbox Stretch="Uniform"><Border Width="225" Height="300" Background="#CBD5E1" ClipToBounds="True">
            <Canvas x:Name="PhotoCropCanvas" Width="225" Height="300" ClipToBounds="True" Background="#CBD5E1">
              <Image x:Name="PhotoPreview" Stretch="Fill" MouseLeftButtonDown="PhotoPreview_MouseLeftButtonDown" MouseMove="PhotoPreview_MouseMove" MouseLeftButtonUp="PhotoPreview_MouseLeftButtonUp"/>
              <Border x:Name="ResizeTopLeft" Tag="TopLeft" Width="14" Height="14" Canvas.Left="0" Canvas.Top="0" Background="#2563EB" BorderBrush="White" BorderThickness="2" Cursor="SizeNWSE" Panel.ZIndex="10" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp" Visibility="Collapsed"/>
              <Border x:Name="ResizeTopRight" Tag="TopRight" Width="14" Height="14" Canvas.Left="211" Canvas.Top="0" Background="#2563EB" BorderBrush="White" BorderThickness="2" Cursor="SizeNESW" Panel.ZIndex="10" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp" Visibility="Collapsed"/>
              <Border x:Name="ResizeBottomLeft" Tag="BottomLeft" Width="14" Height="14" Canvas.Left="0" Canvas.Top="286" Background="#2563EB" BorderBrush="White" BorderThickness="2" Cursor="SizeNESW" Panel.ZIndex="10" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp" Visibility="Collapsed"/>
              <Border x:Name="ResizeBottomRight" Tag="BottomRight" Width="14" Height="14" Canvas.Left="211" Canvas.Top="286" Background="#2563EB" BorderBrush="White" BorderThickness="2" Cursor="SizeNWSE" Panel.ZIndex="10" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp" Visibility="Collapsed"/>
            </Canvas>
          </Border></Viewbox>
        </Border>
        <TextBlock x:Name="PhotoInfoText" Text="No hay fotografía seleccionada." Foreground="#64748B" TextWrapping="Wrap"/>
        <TextBlock Text="Arrastra la fotografía para moverla. Usa los cuadros azules de las esquinas para acercar o alejar sin deformarla." Foreground="#64748B" TextWrapping="Wrap" Margin="0,10,0,8"/>
        <Button x:Name="CenterCropButton" Content="Centrar encuadre" Padding="8,6" IsEnabled="False" Click="CenterCrop_Click" HorizontalAlignment="Left"/>
        <Separator Margin="0,16,0,12"/>
        <TextBlock Text="2. HOJA DE IMPRESIÓN" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,10"/>
        <TextBlock Text="Tamaño de papel"/><ComboBox x:Name="PaperCombo" SelectedIndex="0" Margin="0,5,0,10" Padding="6" SelectionChanged="PaperCombo_SelectionChanged"><ComboBoxItem Content="Carta (21,59 × 27,94 cm)"/><ComboBoxItem Content="A4 (21 × 29,7 cm)"/><ComboBoxItem Content="Oficio (21,59 × 33,02 cm)"/></ComboBox>
        <TextBlock Text="Separación entre fotografías (cm)"/><TextBox x:Name="GapText" Text="0,3" Margin="0,5,0,12" Padding="6" TextChanged="GapText_Changed"/>
        <Button Content="Imprimir hoja completa" Padding="12,10" Background="#16A34A" Foreground="White" BorderThickness="0" Click="Print_Click"/>
        <TextBlock x:Name="StatusText" Text="Importa una fotografía para comenzar." Foreground="#64748B" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel></ScrollViewer></Border>
      <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16"><DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="VISTA PREVIA DE LA HOJA" FontWeight="Bold" Foreground="#475569"/><TextBlock x:Name="LayoutInfoText" Text="Cada fotografía mide exactamente 3 × 4 cm." Foreground="#64748B" Margin="0,4,0,0"/></StackPanel>
        <Border Background="#E9EEF5" Padding="14" BorderBrush="#CBD5E1" BorderThickness="1"><Viewbox Stretch="Uniform"><Canvas x:Name="SheetCanvas" Width="816" Height="1056" Background="White"/></Viewbox></Border>
      </DockPanel></Border>
    </Grid>
  </DockPanel>
</Window>