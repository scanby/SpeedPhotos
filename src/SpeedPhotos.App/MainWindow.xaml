<Window x:Class="SpeedPhotos.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SpeedPhotos" Height="760" Width="1250" MinHeight="650" MinWidth="1050" WindowStartupLocation="CenterScreen" Background="#EEF1F6">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#172033" Padding="18,12"><DockPanel>
      <TextBlock Text="SpeedPhotos" Foreground="White" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="＋ Importar fotografías" Padding="14,8" Margin="8,0,0,0" Click="ImportPhotos_Click"/>
        <Button Content="Limpiar selección" Padding="14,8" Margin="8,0,0,0" Click="ClearPhotos_Click"/>
      </StackPanel>
    </DockPanel></Border>
    <StatusBar DockPanel.Dock="Bottom"><StatusBarItem><TextBlock x:Name="StatusText" Text="Listo. Importa fotografías para comenzar."/></StatusBarItem></StatusBar>
    <Grid Margin="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,12,0">
        <DockPanel><TextBlock DockPanel.Dock="Top" Text="FOTOGRAFÍAS IMPORTADAS" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,12"/>
          <ListBox x:Name="PhotosList" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,4">
            <Image Source="{Binding Thumbnail}" Width="54" Height="54" Stretch="UniformToFill" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="VISTA PREVIA DE IMPRESIÓN" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="PreviousPageButton" Content="◀ Anterior" Padding="8,4" Margin="4,0" Click="PreviousPage_Click" IsEnabled="False"/>
              <TextBlock x:Name="PageIndicator" Text="Hoja 0 de 0" VerticalAlignment="Center" Margin="8,0"/>
              <Button x:Name="NextPageButton" Content="Siguiente ▶" Padding="8,4" Margin="4,0" Click="NextPage_Click" IsEnabled="False"/>
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Background="#E9EEF5" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12">
            <Viewbox Stretch="Uniform"><Canvas x:Name="PreviewCanvas" Width="816" Height="1056" Background="White"/></Viewbox>
          </Border>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="CONFIGURACIÓN DE HOJA" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,16"/>
          <TextBlock Text="Tamaño de papel"/><ComboBox x:Name="PaperCombo" SelectedIndex="0" Margin="0,5,0,10" Padding="5" SelectionChanged="Settings_Changed"><ComboBoxItem Content="Carta"/><ComboBoxItem Content="A4"/><ComboBoxItem Content="Oficio"/></ComboBox>
          <TextBlock Text="Orientación del papel"/><ComboBox x:Name="OrientationCombo" SelectedIndex="0" Margin="0,5,0,10" Padding="5" SelectionChanged="Settings_Changed"><ComboBoxItem Content="Vertical"/><ComboBoxItem Content="Horizontal"/></ComboBox>
          <TextBlock Text="Ancho de fotografía (cm)"/><TextBox x:Name="PhotoWidthText" Text="10" Margin="0,5,0,10" Padding="6"/>
          <TextBlock Text="Alto de fotografía (cm)"/><TextBox x:Name="PhotoHeightText" Text="15" Margin="0,5,0,10" Padding="6"/>
          <TextBlock Text="Número de hojas (si no defines medidas)"/><TextBox x:Name="DesiredPagesText" Text="1" Margin="0,5,0,10" Padding="6"/>
          <TextBlock Text="Ajuste de fotografía"/><ComboBox x:Name="AspectCombo" SelectedIndex="0" Margin="0,5,0,10" Padding="5"><ComboBoxItem Content="Conservar proporción original"/><ComboBoxItem Content="Ajustar exactamente a la medida"/></ComboBox>
          <TextBlock Text="Margen de hoja (cm)"/><TextBox x:Name="MarginText" Text="0.5" Margin="0,5,0,10" Padding="6"/>
          <TextBlock Text="Separación (cm)"/><TextBox x:Name="GapText" Text="0.3" Margin="0,5,0,16" Padding="6"/>
          <Button Content="Generar distribución" Padding="10" Background="#2563EB" Foreground="White" BorderThickness="0" Click="GenerateLayout_Click"/>
          <TextBlock Text="La vista previa representa la hoja y la posición de cada fotografía. Las imágenes se ajustan al tamaño indicado." TextWrapping="Wrap" Foreground="#64748B" Margin="0,14,0,0"/>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>